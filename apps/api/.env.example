PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vela
SESSION_SECRET=replace-with-a-secret-at-least-32-characters
APP_ORIGIN=http://localhost:3000
APP_NAME=KeepX
COOKIE_SECURE=false
BCRYPT_COST=12
TRUST_PROXY=false

# Password recovery stays off until both of these are set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=KeepX <noreply@example.com>

# Browser push stays off until all three are set. Generate a key pair with web-push; do not commit it.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@example.com

# Phone push stays off until this is set. The current Android package does not register a token.
# EXPO_ACCESS_TOKEN=

# Billing stays off until all three are set. No plan changes without a signed webhook.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
